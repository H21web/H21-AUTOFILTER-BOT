# Copy to .env for local dev. NEVER commit real values.
# Every variable maps 1:1 to a field in app/config.py.

# --- Required ---
BOT_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
WEBHOOK_URL=https://YOUR-HOST/webhook

# --- Optional: security / infra ---
WEBHOOK_SECRET=
LOG_LEVEL=INFO
PORT=8000

# --- Optional: movie metadata ---
TMDB_API_KEY=

# --- Optional: access control ---
ADMIN_IDS=123456789,987654321
FORCE_SUB_CHANNELS=@mychannel,-1001234567890
MAIN_CHANNEL_ID=-1001234567890

# --- Optional: AI replies (OpenAI-compatible chat API) ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Optional: stream/download web player ---
ENABLE_STREAM_PLAYER=true
STREAM_LINK_TTL_HOURS=6

# --- Optional: auto-index (old MoovidexFilterBot CHANNELS logic) ---
INDEX_CHANNELS=-1001234567890,-1009876543210
# Only these channels are auto-indexed on new posts. Empty = disabled.
LOG_CHANNEL=-1001234567890
# DB save errors and unexpected auto-index failures are reported here.
# Index requests from users are also posted here for moderator approval.

# --- Optional: parallel backfill (server-side MTProto indexer) ---
# TG_SESSION=...            # first indexer account (make-session.py)
# TG_SESSIONS=... , ...     # extra accounts = parallel workers (optional)
# TG_API_ID=...  TG_API_HASH=...  INDEXER_IDS=...
BACKFILL_MODE=direct
# direct = pack Bot API file_ids straight from history (fastest:
# ~500-1000 files/sec/account, no PM flood). forward = forward every
# file to the bot first (proven fallback, ~2 files/sec/account).
BACKFILL_DELAY=0.5
# Seconds between forwarded files per account (forward mode only).
BACKFILL_CHUNK=200000
# Message-id range per backfill job (crash-resume granularity).

# --- Optional: admin web dashboard (https://YOUR-HOST/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
