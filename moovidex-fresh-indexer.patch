-            return None
-        if not raw_doc.file_reference:
-            return None
-        fid = FileId(
-            file_type=FileType.DOCUMENT,
-            dc_id=raw_doc.dc_id,
-            media_id=raw_doc.id,
-            access_hash=raw_doc.access_hash,
-            file_reference=bytes(raw_doc.file_reference),
-        )
-        return fid.encode()
-    except Exception as e:  # noqa: BLE001
